{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blackcat:offline-catalog:2",
  "title": "Black Cat offline Linux and Kali learning catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "counts",
    "systems",
    "sources",
    "tools",
    "command_inventory",
    "command_examples",
    "lessons",
    "workflow_templates",
    "learning_paths",
    "research",
    "safety",
    "reference_inventory",
    "taxonomy",
    "workflow_support"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "command_examples": {
      "type": "array",
      "minItems": 212,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "title",
          "category",
          "topic",
          "explanation",
          "expected_result",
          "risk",
          "requires_admin",
          "verification",
          "source_refs",
          "lesson_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "pattern": "^[ -~]{1,512}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "requires_admin": {
            "type": "boolean"
          },
          "lesson_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "object",
            "required": [
              "success_is_not_assumed"
            ],
            "properties": {
              "success_is_not_assumed": {
                "const": true
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "entry_ids",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "command_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "invocation",
          "kind",
          "tool_ids",
          "source_refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "binary",
              "subcommand",
              "shell_builtin"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "invocation": {
            "type": "string",
            "minLength": 1
          },
          "tool_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "steps",
          "prerequisite_lesson_ids",
          "next_lesson_ids",
          "automation_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "automation_policy": {
            "const": "manual_type_only_no_enter"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": [
                "id",
                "command_id",
                "look_for",
                "transitions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "command_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "prerequisite_lesson_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "next_lesson_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "reference_inventory": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "invocation",
          "kind",
          "tool_ids",
          "source_refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "service_unit",
              "manual_reference"
            ]
          }
        }
      }
    },
    "workflow_support": {
      "type": "object",
      "required": [
        "version",
        "coverage",
        "command_workflows",
        "tool_workflows",
        "templates"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "command_workflows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "entry_id",
              "executable",
              "invocation_tokens",
              "manual_topic",
              "discovery_commands",
              "task_builder",
              "automatic_execution"
            ],
            "properties": {
              "automatic_execution": {
                "const": false
              },
              "discovery_commands": {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^[ -~]{1,512}$"
                }
              }
            }
          }
        },
        "tool_workflows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tool_id",
              "package_names",
              "command_entry_ids",
              "mode",
              "automatic_execution"
            ],
            "properties": {
              "automatic_execution": {
                "const": false
              },
              "mode": {
                "enum": [
                  "commands_and_packages",
                  "commands",
                  "package_only"
                ]
              }
            }
          }
        },
        "templates": {
          "type": "array",
          "minItems": 2
        }
      }
    }
  }
}
